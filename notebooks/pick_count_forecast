    "print(\"Total picks:\", f\"{int(tot['n_lines']):,}\", \"| shares:\", (tot / tot[\"n_lines\"]).round(3).drop(\"n_lines\").to_dict())\n",
    "m = panel.groupby(panel.date.dt.to_period(\"M\"))[\"n_lines\"].sum()\n",
    "fig, ax = plt.subplots(figsize=(10, 3)); ax.bar(m.index.astype(str), m.values); ax.set_title(\"Picks per month (first and last months are partial)\")\n",
    "plt.xticks(rotation=90, fontsize=8); plt.tight_layout(); plt.show()"
