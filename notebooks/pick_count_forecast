    "CACHE = OUTPUT / \"daily_counts_cache.csv.gz\"\n",
    "NEED = [\"NO\", \"CREATE_DT\", \"FROM_ITEM\", \"CUST_NAME\", \"FROM_ZONE\"]\n",
    "\n",
    "def parse_dt(s):\n",
    "    t = pd.to_datetime(s, format=\"%m/%d/%Y %I:%M:%S %p\", errors=\"coerce\")\n",
    "    bad = t.isna() & s.notna()\n",
    "    if bad.any():\n",
    "        print(f\"    {bad.sum():,} dates in another format (probably an Excel re-save): re-parsing those with the slower parser\")\n",
    "        t.loc[bad] = pd.to_datetime(s.loc[bad], format=\"mixed\", dayfirst=False)\n",
    "    return t\n",
    "\n",
    "def zone_class(z):\n",
    "    return \"CASE\" if z == CASE_PICK_ZONE else (\"PULL\" if z in PALLET_PULL_ZONES else \"OTH\")\n",
    "\n",
    "def load_raw(path):\n",
    "    d = pd.read_csv(path, usecols=NEED, dtype=str)\n",
    "    missing = [c for c in NEED if c not in d.columns]\n",
    "    assert not missing, f\"{path.name} is missing columns {missing}\"\n",
    "    n0 = len(d)\n",
    "    d = d[d[\"CUST_NAME\"].notna() & (d[\"CUST_NAME\"].str.strip() != \"\")].copy()\n",
    "    d[\"t\"] = parse_dt(d[\"CREATE_DT\"])\n",
    "    d = d.drop(columns=[\"CUST_NAME\", \"CREATE_DT\"])\n",
    "    print(f\"  {path.name}: {n0:,} rows, dropped {n0 - len(d):,} non-customer rows ({(n0 - len(d)) / max(n0, 1):.1%}), \"\n",
    "          f\"{d['t'].min()} to {d['t'].max()}\")\n",
    "    return d\n",
    "\n",
    "t0 = time.time()\n",
    "if REBUILD_FROM_RAW or not CACHE.exists():\n",
    "    assert RAW_FILES, \"No raw files: edit RAW_DIR / RAW_FILES in the settings cell.\"\n",
    "    raw = pd.concat([load_raw(p) for p in RAW_FILES], ignore_index=True)\n",
    "    n_before = len(raw); raw = raw.drop_duplicates(subset=[\"NO\"], keep=\"first\")\n",
    "    print(f\"Removed {n_before - len(raw):,} rows whose transaction number (NO) appeared in more than one file\")\n",
    "    raw = raw.dropna(subset=[\"t\", \"FROM_ITEM\"])\n",
    "    data_min, data_max = raw[\"t\"].min(), raw[\"t\"].max()\n",
    "    lo = data_min.normalize() if data_min == data_min.normalize() else data_min.normalize() + pd.Timedelta(days=1)\n",
    "    hi = data_max.normalize() if data_max == data_max.normalize() else data_max.normalize() - pd.Timedelta(days=1)\n",
    "    raw[\"day\"] = raw[\"t\"].dt.normalize()\n",
    "    print(f\"First and last timestamps: {data_min} / {data_max}. Dropping the partial boundary days; keeping {lo.date()} to {hi.date()}.\")\n",
    "    raw = raw[(raw[\"day\"] >= lo) & (raw[\"day\"] <= hi)]\n",
    "    raw[\"proc\"] = raw[\"FROM_ZONE\"].fillna(\"UNKNOWN\").map(zone_class)\n",
    "    counts = (raw.groupby([\"day\", \"FROM_ITEM\", \"proc\"]).size().unstack(\"proc\", fill_value=0)\n",
    "                 .reindex(columns=[\"CASE\", \"PULL\", \"OTH\"], fill_value=0).reset_index()\n",
    "                 .rename(columns={\"day\": \"date\", \"FROM_ITEM\": \"item_id\"}))\n",
    "    counts[\"n_lines\"] = counts[[\"CASE\", \"PULL\", \"OTH\"]].sum(axis=1)\n",
    "    DAY_LO, DAY_HI = lo, hi\n",
    "    counts.to_csv(CACHE, index=False)\n",
    "    json.dump({\"lo\": str(lo.date()), \"hi\": str(hi.date())}, open(OUTPUT / \"daily_counts_cache_range.json\", \"w\"))\n",
    "    del raw\n",
    "else:\n",
    "    counts = pd.read_csv(CACHE, dtype={\"item_id\": str}, parse_dates=[\"date\"])\n",
    "    rg = json.load(open(OUTPUT / \"daily_counts_cache_range.json\")); DAY_LO, DAY_HI = pd.Timestamp(rg[\"lo\"]), pd.Timestamp(rg[\"hi\"])\n",
    "    print(\"Reusing cache\", CACHE)\n",
    "print(f\"Daily counts ready in {time.time() - t0:.0f}s\")\n",
    "\n",
    "panel = counts.rename(columns={\"CASE\": \"case_pick_lines\", \"PULL\": \"pallet_pull_lines\", \"OTH\": \"other_lines\"})\n",
    "TARGET_COL = \"n_lines\"\n",
    "CONTEXT_COLS = {\"CASE\": \"case_pick_lines\", \"PULL\": \"pallet_pull_lines\", \"OTH\": \"other_lines\"}\n",
    "assert (panel[[\"n_lines\", \"case_pick_lines\", \"pallet_pull_lines\", \"other_lines\"]] >= 0).all().all()\n",
